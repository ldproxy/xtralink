#
# Builds the CGo wrapper as a C shared library. Run from this directory:
#
#   make shared              # -> ./libxtralink.{so,dylib} (or xtralink.dll) plus its header
#   make shared OUT=../../..  # somewhere else
#
# The name is what a foreign caller resolves: it matches Java's
# System.mapLibraryName("xtralink") on every platform below.

PKG ?= .
LIB ?= xtralink
OUT ?= .

UNAME := $(shell uname -s)

ifeq ($(OS),Windows_NT)
  SONAME := $(LIB).dll
else ifeq ($(UNAME),Darwin)
  SONAME := lib$(LIB).dylib
else
  SONAME := lib$(LIB).so
endif

.PHONY: shared clean

shared:
	go build -buildmode=c-shared -o $(OUT)/$(SONAME) $(PKG)

clean:
	rm -f $(OUT)/$(SONAME) $(OUT)/lib$(LIB).h
